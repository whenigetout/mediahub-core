# Copy this file to backend/.env to configure the API.
# Every value is optional: the app runs with built-in defaults.

# Port for the Fastify API. The web UI expects http://localhost:4000.
PORT=4000

# Natural-language search (optional). Requires a local Ollama server.
# Without these two values the app falls back to a built-in heuristic parser.
# OLLAMA_SEARCH_MODEL=qwen2.5:3b
# OLLAMA_SEARCH_URL=http://127.0.0.1:11434/api/generate
